    "counter_semantics": {
      "fuel": {
        "parameter_path": ["Stats", "FuelUsed"],
        "scorer_unit_label": "kg",
        "activity_vector_linear_components": "jet_force_divided_by_vehicle_mass",
        "max_on_time": "max(max(onTimes), 0)",
        "zero_impulse_guard": "max_on_time < 1e-12",
        "firing_time_s": "remap(max(onTimes[i], 0), 0, max_on_time, 0, min(dt_tick, max_on_time))",
        "jet_linear_impulse_ns": "mass * min(firing_time_s, dt_tick) * A[i, 0:3]",
        "jet_angular_impulse_nms": "inertia @ (min(firing_time_s, dt_tick) * A[i, 3:6])",
        "increment_per_iteration": "sum_i(norm(jet_linear_impulse_ns[i]) / (80 * 9.8))",
        "timestep_multiplier_applied": true,
        "force_conversion_mass_multiplier_applied": true,
        "timestep_source": "difference_of_SimClock_timestamps_not_fixed_1_over_60",
        "nonpositive_timestep_skipped": true,
        "configured_loop_hz": 60.0,
        "direct_command": false,
        "effect_application": "summed_linear_and_angular_impulses_in_body_frame",
        "minimum_on_time_filter": "selects_OnThrustersMain_indices_but_does_not_filter_impulse_or_fuel_sum",
        "specific_impulse_s": 80.0,
        "standard_gravity_mps2": 9.8,
        "local_si_fuel_equivalence_certified": false
      },
      "damage": {
        "parameter_path": ["Stats", "Damage"],
        "scorer_unit_label": "J",
        "official_description": "collision energy extracted from STP physics engine hit outputs",
        "full_accumulator_source_in_reviewed_repositories": false,
        "local_damage_equivalence_certified": false
      },
      "time": {
        "origin": "scoring_system_initialization",
        "assessment_sample": "preceding_iteration_elapsed_accumulator",
        "configured_loop_hz": 10.0,
        "scoring_loop_stops_physics_on_terminal": false,
        "local_clock_equivalence_certified": false
      }
    },
    "note": "Current main uses 75 kg and max(F/F_nom, 0). Its actuator now integrates per-jet impulses using actual elapsed time and mass. Local SI fuel is not incompatible by units alone; allocation, angular fuel, physics and timing still differ. Current-formula local estimates are not licensed STP receipts."
