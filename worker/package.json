{
  "name": "western-sydney-orbital-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "cf": "node scripts/cloudflare.mjs cf",
    "wrangler": "node scripts/cloudflare.mjs wrangler",
    "login:cf": "node scripts/cloudflare.mjs cf auth login --force",
    "login:wrangler": "node scripts/cloudflare.mjs wrangler login",
    "account": "node scripts/cloudflare.mjs account",
    "deploy": "npm run account && npm run build && node scripts/cloudflare.mjs wrangler deploy",
    "types": "node scripts/cloudflare.mjs wrangler types",
    "build:web": "node scripts/build-web.mjs",
    "build:sim": "bash scripts/build-sim.sh",
    "build:licenses": "node scripts/build-licenses.mjs",
    "build": "npm run types && npm run build:sim && npm run build:web && npm run build:licenses"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.20",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  }
}
